    "seed": "node scripts/seed.ts",
    "demo": "node scripts/demo.ts",
    "test": "node --test \"tests/*.test.ts\"",
    "backup": "node scripts/backup.ts",
    "restore": "node scripts/restore.ts",
    "rotate-key": "node scripts/rotate-key.ts",
    "gis-demo": "node gis-demo/src/server.ts",
    "gis-demo:fetch": "node gis-demo/src/fetch/fetchStatic.ts"
  },
  "dependencies": {},
  "devDependencies": {}
}
